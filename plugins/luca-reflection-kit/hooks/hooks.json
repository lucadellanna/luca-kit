{
  "description": "Reflection plugin hooks: optimization-hint reminder after high-tool-count turns.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/optimization-hint.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
